# Copia este archivo como .env (en la misma carpeta que docker-compose.yml) y rellénalo.
# El .env tiene secretos: no lo subas a GitHub ni lo compartas.

# Contraseña del panel del anfitrión (https://tu-dominio/admin). Mínimo 8 caracteres.
VTT_ADMIN_PASSWORD=

# Dirección pública de la mesa (la del túnel), sin barra final. Ejemplo: https://mesa.midominio.xyz
VTT_PUBLIC_URL=

# Token del túnel de Cloudflare (Networking → Tunnels → tu túnel; es la cadena larga después de --token).
CLOUDFLARE_TUNNEL_TOKEN=
