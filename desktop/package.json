{
  "name": "@pyv/desktop",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "main": "main.mjs",
  "description": "Puercos y Verrugas VTT",
  "author": "Puercos y Verrugas VTT",
  "scripts": {
    "start": "electron .",
    "prepare:app": "node scripts/prepare.mjs",
    "dist": "node scripts/prepare.mjs && electron-builder --win"
  },
  "dependencies": {
    "@fastify/multipart": "^9.0.0",
    "@fastify/static": "^10.1.8",
    "cookie": "^1.0.0",
    "fastify": "^5.0.0",
    "socket.io": "^4.8.0",
    "tailwindcss": "^4.3.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "electron": "^45.2.2",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "local.puercos-y-verrugas-vtt",
    "productName": "Puercos y Verrugas VTT",
    "directories": {
      "output": "../release"
    },
    "asar": false,
    "files": [
      "main.mjs",
      "app/**"
    ],
    "win": {
      "target": "nsis"
    }
  },
  "allowScripts": {
    "electron@45.2.3": true,
    "electron-winstaller@5.4.0": true
  }
}
